PORT=3000

# MongoDB
MONGO_DB=mongodb+srv://<user>:<pass>@<cluster>/
MONGO_DB_NAME=portafolio

# Optional: folder with the project JSON files (default: ./content/proyectos)
# PROYECTOS_DIR=

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:5173,https://tu-sitio.web.app

# Firebase Storage (admin file manager)
FIREBASE_STORAGE_BUCKET=proyectos-andres.firebasestorage.app
# Service account: locally put the JSON key at ./service_account.json (git-ignored).
# On Heroku paste the whole JSON as this Config Var instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Used only by `npm run seed:admin` to create the first ADMIN
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_EMAIL=admin@example.com



# Proyecto #3, the multiplayer racing game (Socket.IO on /juego). All optional.
# JUEGO_TICK_HZ=30          simulation ticks per second
# JUEGO_MAX_SALAS=50        rooms open at the same time
# JUEGO_CIRCUITO=prueba     circuit file in content/juego/circuitos

# El pulso de Hermosillo: news analysis with an LLM. It only runs as jobs started
# from the admin panel (Análisis), each with its own budget.
# GEMINI_API_KEY=...
# PULSO_MODELO=gemini-3.8-flash
# Max tokens (in + out) per day, and USD per million tokens to estimate the cost
# PULSO_TOKENS_DIA=3000000      (safety net; a job's approved budget can go past it)
# PULSO_PRESUPUESTO_MAX=500     (largest budget one job can have, USD)
# PULSO_PRECIO_ENTRADA=0.75
# PULSO_PRECIO_SALIDA=3.75
