PORT=3000

# MongoDB
MONGO_DB=mongodb+srv://<user>:<pass>@<cluster>/
MONGO_DB_NAME=portafolio

# Optional: folder with the project JSON files (default: ./content/proyectos)
# PROYECTOS_DIR=

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:5173,https://tu-sitio.web.app

# Firebase Storage (admin file manager)
FIREBASE_STORAGE_BUCKET=proyectos-andres.firebasestorage.app
# Service account: locally put the JSON key at ./service_account.json (git-ignored).
# On Heroku paste the whole JSON as this Config Var instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Used only by `npm run seed:admin` to create the first ADMIN
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_EMAIL=admin@example.com



# Proyecto #3, the multiplayer racing game (Socket.IO on /juego). All optional.
# JUEGO_TICK_HZ=60          physics and control ticks per second (default 60)
# JUEGO_ESTADO_HZ=30        network snapshots per second, capped at JUEGO_TICK_HZ (default 30)
# JUEGO_MAX_SALAS=50        rooms open at the same time
# JUEGO_CIRCUITO=hermosillo default map (rooms can pick any in content/juego/circuitos)
# JUEGO_PUNTOS_VICTORIA=5   points to win a match
# JUEGO_FIREBASE_PROYECTO=  Firebase project id of the players' accounts (Google, Apple, guest).
#                           Empty: no accounts, everybody plays with the default vehicle only
# JUEGO_MONGO_DB=           the MongoDB server with what each account bought (default: MONGO_DB)
# JUEGO_MONGO_DB_NAME=edge_racers   the game's own database on it (apart from the portfolio's)
# JUEGO_VEHICULOS_DESBLOQUEADOS=true   everybody can use every vehicle (testing only)
# Real-money purchases (App Store / Google Play), verified here (src/juego/servidor/compras.ts):
# JUEGO_APPLE_BUNDLE_ID=mx.jorgeandresgarcia.edgeracers   the iOS bundle id (this one by default)
# JUEGO_APPLE_APP_ID=       the app's numeric Apple ID (App Store Connect → App Information).
#                           Without it only Sandbox/TestFlight purchases are accepted
# JUEGO_APPLE_SIN_SANDBOX=true   refuse Sandbox purchases (careful: Apple's review buys in Sandbox)
# JUEGO_GOOGLE_PAQUETE=mx.jorgeandresgarcia.edgeracers    the Android package (this one by default)
# JUEGO_GOOGLE_CUENTA_SERVICIO=   the JSON (one line) of the Google Cloud service account invited
#                           to Play Console with "View financial data" and "Manage orders"

# El pulso de Hermosillo: news analysis with an LLM. It only runs as jobs started
# from the admin panel (Análisis), each with its own budget.
# GEMINI_API_KEY=...
# PULSO_MODELO=gemini-3.8-flash
# Max tokens (in + out) per day, and USD per million tokens to estimate the cost
# PULSO_TOKENS_DIA=3000000      (safety net; a job's approved budget can go past it)
# PULSO_PRESUPUESTO_MAX=500     (largest budget one job can have, USD)
# PULSO_PRECIO_ENTRADA=0.75
# PULSO_PRECIO_SALIDA=3.75
